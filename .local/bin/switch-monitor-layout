#!/usr/bin/env bash
#
# Point ~/.config/hypr/monitors.lua (a symlink, not tracked in git, loaded by
# hyprland.lua via require("monitors")) at one of the tracked layout files.
# "default" uses the per-host layout monitors-<short-hostname>.lua, falling
# back to monitors_default.lua.

if [ "$#" -ne 1 ]; then
  msg="Usage: $0 {default|beamer|only-beamer}"
  echo "$msg"
  notify-send "Monitor" "$msg"
  exit 1
fi

config_folder="$HOME/.config/hypr"
monitor_conf="${config_folder}/monitors.lua"
host="$(uname -n)"
host="${host%%.*}"

# The beamer layouts describe the tower (YST: DP-1/DP-2 + projector on HDMI-A-1).
# On the laptop they would leave eDP-1 without a rule, so only "default" there.
if [ "$1" != default ] && [ "${host,,}" != yst ]; then
  msg="Layout '$1' is only for the tower (YST); using default on ${host}."
  echo "$msg"
  notify-send "Monitor" "$msg"
  set -- default
fi

case $1 in
  default)
    target="monitors-${host}.lua"
    [ -f "${config_folder}/${target}" ] || target="monitors_default.lua"
    ;;
  beamer)
    target="monitors_with_beamer.lua"
    ;;
  only-beamer)
    target="monitors_only_beamer.lua"
    ;;
  *)
    msg="Invalid option. Use one of: default, beamer, only-beamer."
    echo "$msg"
    notify-send "Monitor" "$msg"
    exit 1
    ;;
esac

# Relative symlink; never cp onto monitors.lua (that would overwrite the
# tracked file it currently points to).
ln -sfn "$target" "$monitor_conf"
# Swapping a symlink may not trigger Hyprland's file watcher, so reload explicitly.
hyprctl reload >/dev/null

msg="Switched monitor setup to: $1 ($target)"
echo "$msg"
notify-send "Monitor" "$msg"
