#!/usr/bin/env bash
# Agent hub: one kitty (class agents-hub) on workspace name:agents, attached to tmux.
#   agents-hub attach        run inside the hub kitty: keep a tmux client attached (loop)
#   agents-hub empty         runs inside the "hub" placeholder session: session picker, then shell
#   agents-hub pick          go to the hub and open the tmux-pick popup in it (fallback for
#                            SUPER+SHIFT+I when quickshell isn't running)
#   agents-hub go SESSION    go to the hub and show SESSION in it (quickshell switcher, island)
# Everything is inside main() so bash parses the whole file up front - editing this script
# while a hub loop is running cannot break the running loop.
set -u

self=$(readlink -f "$0")

is_descendant() { # is pid $1 a descendant of pid $2?
    local p=$1
    while [[ -n $p && $p != 1 && $p != 0 ]]; do
        [[ $p == "$2" ]] && return 0
        p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
    done
    return 1
}

enter() { # go to workspace "agents" (on_created_empty launches the hub if needed)
    # (Hyprland >= 0.57: `hyprctl dispatch` takes a Lua expression, not the old dispatcher syntax)
    [[ $(hyprctl -j activeworkspace | jq -r .name) == agents ]] ||
        hyprctl dispatch 'AgentsHubEnter()' >/dev/null
}

hub_client() { # tty of the hub's tmux client (a descendant of the hub kitty); waits up to 5 s
    local kpid client
    for _ in $(seq 50); do
        kpid=$(hyprctl -j clients | jq -r '.[] | select(.class=="agents-hub") | .pid' | head -1)
        if [[ -n $kpid ]]; then
            client=$(tmux list-clients -F '#{client_pid} #{client_tty}' 2>/dev/null |
                while read -r pid tty; do
                    is_descendant "$pid" "$kpid" && echo "$tty" && break
                done)
            [[ -n $client ]] && { echo "$client"; return 0; }
        fi
        sleep 0.1
    done
    notify-send "agents-hub" "hub tmux client not found"
    return 1
}

main() {
    case ${1:-attach} in
    attach)
        # Keep the hub alive: when the viewed session ends (pi exits, killed, detached),
        # attach the next most recent session, or - if none is left - a "hub" session that
        # shows the session picker (C-n = new pi). Close the hub window with SUPER+SHIFT+Q.
        while :; do
            if tmux has-session 2>/dev/null; then tmux attach
            else tmux new-session -s hub "$self empty"; fi
            sleep 0.2   # guard against a tight loop if tmux fails
        done
        ;;
    empty)
        "$HOME/.local/bin/tmux-pick"
        # switched to another session (e.g. C-n = new pi) -> this placeholder session can go
        [[ $(tmux display -p -t "$TMUX_PANE" '#{session_attached}') == 0 ]] && exit 0
        exec "${SHELL:-zsh}"   # picker quit with Esc -> plain shell
        ;;
    pick)
        local client
        enter
        client=$(hub_client) || exit 1
        tmux display-popup -c "$client" -B -E -w 88% -h 80% "$HOME/.local/bin/tmux-pick"
        ;;
    go)
        local session=${2:?session} client
        tmux has-session -t "=$session" 2>/dev/null || { notify-send "agents-hub" "no session $session"; exit 1; }
        enter
        client=$(hub_client) || exit 1
        tmux switch-client -c "$client" -t "=$session"
        # the placeholder session (picker still open in it) isn't needed any more
        [[ $session != hub && $(tmux display -p -t '=hub:' '#{session_attached}' 2>/dev/null) == 0 ]] &&
            tmux kill-session -t =hub
        return 0
        ;;
    *)
        echo "usage: agents-hub attach|empty|pick|go SESSION" >&2; exit 2 ;;
    esac
}

main "$@"
exit
